# SnapDesk Environment Configuration
# Mode: "mock" (default for free local testing without API key) or "real" (calls Meta Model API)
SNAPDESK_MODE=mock

# Meta Model API Key (Required only for real mode)
# Obtain from https://dev.meta.ai/ -> API Keys
# Format: LLM|{id}|{secret}
# CRITICAL: Keep your real key in .env (which is git-ignored). NEVER commit real keys.
MODEL_API_KEY=<insert your api key here>

# Models (Standard-tier Meta models)
# NOTE: Muse Image is excluded (restricted under Meta Geographic Use Policy).
# Only Standard-tier IDs are used to protect customer data.
SPARK_MODEL=muse-spark-1.3
SAM_MODEL=sam-3.1
VOICE_MODEL=muse-voice-transcribe-1.0

# API Safety & Budget Controls
MAX_CALLS=100
PORT=3000

